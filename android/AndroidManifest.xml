<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lexicards.app"
    android:versionCode="16"
    android:versionName="2.5">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The daily reminder (v2.5).  POST_NOTIFICATIONS is a dangerous
         permission but nothing asks for it at install: the dialog appears only
         when the user turns the reminder on.  SCHEDULE_EXACT_ALARM is denied
         by default on API 33+, and the receiver falls back to the inexact alarm
         when it is not granted.  RECEIVE_BOOT_COMPLETED is a normal permission,
         so re-arming after a reboot also costs the user nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:theme="@style/SplashTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- One launcher alias per skin.  An installed app's home-screen icon
             comes from the manifest, so it cannot be repainted in place: the
             skin is chosen by enabling exactly one alias and disabling the
             others (PackageManager, from LexiNative.setLauncherIcon on the web
             side, which runs for classic too).  The classic alias starts
             enabled, so a fresh install looks exactly as it always has. -->
        <activity-alias
            android:name=".LauncherClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherGothic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gothic"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_gothic_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/GothicSplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPrimevere"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_primevere"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_primevere_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/PrimevereSplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Fires the daily reminder and re-arms it after a reboot.  exported
             because Android 12+ requires an explicit value here; the only
             action in the filter is the protected BOOT_COMPLETED broadcast,
             which no other app can send, and every other action is ignored. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
